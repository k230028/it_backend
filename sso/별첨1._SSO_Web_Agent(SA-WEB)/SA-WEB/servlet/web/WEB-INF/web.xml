<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:web="http://java.sun.com/xml/ns/javaee" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" id="WebApp_ID" version="2.5">
    <display-name>SA-WEB-SERVLET</display-name>

    <!-- SSO 서블릿 매핑 -->
    <servlet>
        <servlet-name>Business</servlet-name>
        <servlet-class>com.pentasecurity.business.Business</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Business</servlet-name>
        <url-pattern>/sso/Business</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>CheckAuth</servlet-name>
        <servlet-class>com.pentasecurity.business.CheckAuth</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckAuth</servlet-name>
        <url-pattern>/sso/CheckAuth</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>Logout</servlet-name>
        <servlet-class>com.pentasecurity.business.Logout</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>Logout</servlet-name>
        <url-pattern>/sso/Logout</url-pattern>
    </servlet-mapping>



    <!-- SSO Config 리스너 설정 -->
    <listener>
        <listener-class>com.pentasecurity.config.ConfigureSettingListner</listener-class>
    </listener>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
