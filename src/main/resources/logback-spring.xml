<?xml version="1.0" encoding="UTF-8"?>
<!--
  IT Portal 백엔드 로깅 설정.
  - Spring Boot 기본 변환 규칙(컬러/패턴)을 포함하고, 콘솔 + 파일 appender를 구성합니다.
  - 파일 로그는 1개월 단위로 롤오버합니다(fileNamePattern의 %d{yyyy-MM}).
  - 모든 프로파일의 로그 저장 경로는 /log/springitp입니다.
  - 로그 레벨(logging.level.*)은 application*.properties에서 계속 제어합니다.
-->
<configuration>
    <!-- Spring Boot 기본 정의: CONSOLE_LOG_PATTERN, FILE_LOG_PATTERN 등 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 프로파일 누락 시에도 서버 공통 로그 경로를 사용 -->
    <property name="LOG_PATH" value="/log/springitp"/>

    <!-- 서버 프로파일은 전용 로그 경로로 재정의 -->
    <springProfile name="dev,prod">
        <property name="LOG_PATH" value="/log/springitp"/>
    </springProfile>

    <!-- 로그 파일 기본 이름 -->
    <property name="LOG_FILE_NAME" value="it-backend"/>

    <!-- 콘솔 출력 -->
    <!--
      콘솔 charset은 JVM이 감지한 콘솔 인코딩(stdout.encoding)에 맞춘다.
      logback ConsoleAppender는 stdout.encoding(PrintStream)을 무시하고 이 <charset>으로
      바이트를 직접 출력하므로, 고정 UTF-8이면 Windows 한글 콘솔(MS949)에서 한글이 깨진다
      (예: "인증서버" → "?몄쬆?쒕쾭"). stdout.encoding은 JDK 18+가 콘솔 코드페이지로 설정하므로
      Windows=MS949 / Linux=UTF-8로 자동 정합된다. 속성 미해석 시 UTF-8로 폴백(기존 동작).
      파일 appender는 도구가 UTF-8로 읽으므로 UTF-8 고정 유지.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${stdout.encoding:-UTF-8}</charset>
        </encoder>
    </appender>

    <!-- 파일 출력 (1개월 단위 롤오버) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 현재 기록 중인 활성 파일 -->
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- %d{yyyy-MM} → 월이 바뀔 때 it-backend.YYYY-MM.log 로 보관 -->
            <fileNamePattern>${LOG_PATH}/${LOG_FILE_NAME}.%d{yyyy-MM}.log</fileNamePattern>
            <!-- 보관 개월 수 (12개월 경과분 자동 삭제) -->
            <maxHistory>12</maxHistory>
            <!-- 전체 보관 용량 상한 (초과 시 오래된 보관본부터 삭제) -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 관리자 화면 조회용 인메모리 링버퍼 (재기동 시 소실, 파일 로그와 별개) -->
    <appender name="RINGBUFFER" class="com.kdb.it.common.admin.waslog.appender.RingBufferAppender">
        <capacity>2000</capacity>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="RINGBUFFER"/>
    </root>
</configuration>
